# Preview works without environment variables. Never put credentials in client variables.
# Production is also blocked until config/launch.json passes npm run check:launch.
SITE_DEPLOYMENT=preview
# Optional verified HTTPS origin override; evaluated by both build gates and metadata.
CANONICAL_DOMAIN=
# Public verification token from the real owner's Search Console property. Live only.
GOOGLE_SITE_VERIFICATION=
# Optional; production callback handling requires all three, an approved processor,
# verified retention policy and approved callback staffing. Redis must support EVAL.
CALLBACK_WEBHOOK_URL=
CALLBACK_WEBHOOK_TOKEN=
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_HASH_SECRET=
# Only loaded in approved production after explicit analytics consent.
NEXT_PUBLIC_GOOGLE_TAG_ID=
